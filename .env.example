DATABASE_URL=postgresql://aic:aic@localhost:5432/aic
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Reasoning for each model: empty for the model's default, off, or minimal/low/medium/high/xhigh.
# A reasoning model can spend the whole answer length thinking; off fixes that for answers.
OPENROUTER_REASONING=off
# Optional: a stronger model for Teach me, Flashcards and Practice only. Empty uses OPENROUTER_MODEL.
OPENROUTER_STUDY_MODEL=
OPENROUTER_STUDY_REASONING=
# The reasoning model that redoes the math in Teach me and Practice problems to check it.
OPENROUTER_CHECK_MODEL=openai/gpt-5.6-luna
OPENROUTER_CHECK_REASONING=
# The vision model that reads scanned PDFs (pages that are only pictures of text).
OPENROUTER_OCR_MODEL=google/gemini-3.5-flash
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# Google sign-in: the team's OAuth client (README, "Google sign-in"). Ask the maintainer for the
# values; they are shared privately and never committed. Without them, sign-in answers 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the sign-in state cookie. Required: at least 32 random characters, or /auth/google/login
# answers 503. Generate one with: openssl rand -base64 48
SESSION_SECRET=
# Must match an Authorized Redirect URI registered on the Google OAuth client.
AUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Only verified Google Workspace accounts from this domain (hd claim + email suffix) are allowed.
ALLOWED_EMAIL_DOMAIN=ucsd.edu
# Set to true when serving behind HTTPS so session cookies include the Secure flag.
COOKIE_SECURE=false
# The Chrome extension allowed to call the backend from its own origin (CORS). 32 letters a-p; the
# default is the stable id that the manifest key gives the unpacked extension.
EXTENSION_ID=gdgflcpoijokbdnckcojphfoinhkbbmd
# Host names the backend answers to (comma-separated, port ignored); anything else gets 400. Add a
# name only if you serve the backend under one. "*" is ignored.
ALLOWED_HOSTS=localhost,127.0.0.1
