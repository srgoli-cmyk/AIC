DATABASE_URL=postgresql://aic:aic@localhost:5432/aic
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional: a stronger model for Teach me, Flashcards and Practice only. Empty uses OPENROUTER_MODEL.
OPENROUTER_STUDY_MODEL=
# The reasoning model that redoes the math in Teach me and Practice problems to check it.
OPENROUTER_CHECK_MODEL=openai/gpt-5.6-luna
# The vision model that reads scanned PDFs (pages that are only pictures of text).
OPENROUTER_OCR_MODEL=google/gemini-3.5-flash-lite
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
