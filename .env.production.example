# Production settings for docker-compose.prod.yml. On the server: cp .env.production.example .env,
# fill in every value, then chmod 600 .env. Never commit the filled-in file.

# The public name. Its DNS A record must point at this server before the first start (HTTPS).
DOMAIN=ailecture.app
# Let's Encrypt sends certificate notices here.
ACME_EMAIL=CHANGE_ME@example.com

# Database password: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=CHANGE_ME

# OpenRouter key for answers and study tools. Use a key with its own credit limit.
OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_REASONING=off
OPENROUTER_STUDY_MODEL=
OPENROUTER_STUDY_REASONING=
OPENROUTER_CHECK_MODEL=openai/gpt-5.6-luna
OPENROUTER_CHECK_REASONING=
OPENROUTER_OCR_MODEL=google/gemini-3.5-flash

# Google sign-in: the team's OAuth client, with https://<DOMAIN>/auth/google/callback added as an
# authorized redirect URI and https://<DOMAIN> as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
ALLOWED_EMAIL_DOMAIN=ucsd.edu

# Signs the sign-in state: openssl rand -base64 48. Use a new one here, not your dev one.
SESSION_SECRET=CHANGE_ME

# The Chrome Web Store extension's id (32 letters a-p, shown in the Web Store dashboard). Only that
# extension may call the backend from its own origin.
EXTENSION_ID=CHANGE_ME
